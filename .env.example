# Copy to `.env` (gitignored) and fill in. NEVER commit `.env` (it holds the private key).
# Read from the environment ONLY — the code never writes/logs/transmits the key
# anywhere but the Polymarket CLOB API (for order signing).
#
# === LIVE DEPLOYMENT — config recorded so it's never lost (NONE of this is secret) ===
#   Account (funder/proxy): 0xe98BAA12D2EE4be2A68577F47CBD986d9f4576e6
#   Signer EOA (from key):  0xb9c8261f9108856970b69c440e6913a33ad438d7
#   signature_type=1 (Polymarket email/magic) | funded ~$50
#   Verified by `PM_TRADER_LIVE=1 ./cpp/build/balance-check` -> CLOB collateral $50.20.
#   The ONLY secret is POLYMARKET_PRIVATE_KEY (see restore note below). Everything
#   else here is the full, ready-to-use config — copy this file to .env and set the key.
# =====================================================================================

# Signer private key (EOA that controls the funded Polymarket wallet).
# DO NOT paste the real key here or anywhere git-tracked. On the box, set it via:
#     bash /root/polymarket-live-maker/set_pmkey.sh     (reads it from hidden input)
# Restore source if ever lost: Polymarket -> Settings -> Account -> Private Key
#   (account 0xe98B…76e6); also backed up in .env.bak.* on the box.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket proxy/funder wallet address + signature type (NOT secret — safe to track).
# signature_type: 0 = EOA, 1 = email/magic proxy, 2 = browser-wallet proxy.
POLYMARKET_FUNDER=0xe98BAA12D2EE4be2A68577F47CBD986d9f4576e6
POLYMARKET_SIGNATURE_TYPE=1

# ---------------------------------------------------------------------------
# REAL-MONEY GO-LIVE — the operator's explicit switch (default OFF).
# Unset or != "1" -> DRY-RUN: the bot computes/logs every order it WOULD place
# but submits NOTHING. Set to 1 ONLY when you intend to trade real funds.
PM_TRADER_LIVE=0

# DEAD-MAN'S SWITCH (offline protection). 0 = GTC orders rest until we cancel -> if
# the process/server goes offline, resting orders can be picked off un-cancelled.
# Set to seconds (e.g. 300) to place GTD orders that Polymarket AUTO-CANCELS after
# this long even if our box is dead -> offline pick-off exposure bounded to ~this.
# The bot re-places at half this interval so online pools stay covered. RECOMMENDED
# for live (e.g. 300). Min 60 (PM's GTD threshold). 0 in dry-run is harmless.
LM_ORDER_EXPIRY_S=0

# ---------------------------------------------------------------------------
# Capital & risk (safe starter values — ramp up only after multi-day survival).
LM_CAPITAL=45             # total USDC budget across the book (matched to funded ~$50) — this (with min_size +
                          # the supply of uncorrelated SAFE pools) is the sole exposure
                          # throttle; pool COUNT is governed dynamically (no hard cap)
LM_MIN_DAILY=80           # ignore reward pools paying less than this $/day
LM_SCAN_TOP=0             # 0 = scan ALL eligible pools each scan (never hide a SAFE pool
                          # in the tail). Scan is off the hot loop + low-priority, so our
                          # 149/s budget is NOT the constraint. Set a positive N only to
                          # limit load on Polymarket's API if a scan gets throttled
LM_MAX_TOKEN_OVERLAP=1    # correlation filter: drop a pool sharing > this many distinctive
                          # tokens with an already-picked one. Raise to 2 for a wider book
LM_POLL_SECONDS=1.0       # reaction cadence (worst-case cancel latency). WS feeds the
                          # book for free, so the loop can run fast; lower to 0.2-0.5
                          # for faster reaction (more ledger churn).
LM_DISCOVERY_INTERVAL_S=600    # reward-universe re-scan cadence (runs off the hot loop)
LM_MAX_LOSS_PER_DAY=20    # kill-switch: stand down if realized book loss exceeds this
LM_COOLDOWN_ROUNDS=3      # discovery rounds a jumped pool stays benched
LM_SIZE_SHARE_CAP=0.33    # capital-aware sizing is always on: size up each pool toward a
                          # score-weighted slice, but cap our est per-pool share here (stay
                          # productive; don't dominate the pool / become the pickoff target).
                          # A tight budget / zero loss budget floors size at the pool min_size
LM_QUALITY_FLOOR_FRAC=0.10 # dynamic allocation "度": fund a pool only while its risk-adj
                          # score >= this fraction of the BEST pool's (drops the junk
                          # tail; pool COUNT is dynamic, not a hard cap). Higher = more
                          # concentrated in quality (more \$/yr, less diversification);
                          # lower = broader. Size also flows to quality (size ∝ score)
LM_MAX_POOL_FRAC=0.25     # diversification: no single pool gets more than this fraction
                          # of capital when sizing up (caps concentration risk)
LM_MIN_POOL_REWARD=0.5    # entry AND reeval-exit floor: a pool must earn >= this $/day
                          # (share x daily). Reward-based, NOT share — a small share of
                          # a big pool still pays (live shares of 0.3-1.8% are normal)
LM_CHOP_AVERSION=0.7      # 0..1: how hard selection avoids choppy (high-vol) books.
                          # small speed credit by default (cancel-efficiency unmeasured
                          # until live fills); lower toward 0.3-0.5 once live data shows
                          # we catch chop. jump-tail stays FULLY weighted (gap < cancel)
LM_MAX_MID_VEL_CPS=4.0    # exit a held pool whose mid moves faster than this (c/s);
                          # choppy book = pick-off bleed. 0 = off

# ---------------------------------------------------------------------------
# Real-time market data + request budget.
LM_WS=1                   # 1 = WebSocket book + fills (REST fallback if WS drops)
LM_MAX_REQ_PER_SEC=149    # global CLOB request cap (token bucket); ~149 is the limit
LM_WRITE_RESERVE=20       # tokens reserved for cancels/places (high priority) so they
                          # never queue behind reads — reads fill 149 minus this
LM_BOOK_RESYNC_WORKERS=8  # concurrent REST /book re-sync workers (low priority): soak
                          # the leftover budget to keep the WS book authoritative. 0=off
LM_STATS_EVERY_S=60       # periodically log req/s (read/write) + load avg (CPU gauge)
# LM_WS_PROXY=socks5://host:port   # route WS through a proxy (default: direct).
                          # Only needed if the WS host is unreachable directly from
                          # the server.

# ---------------------------------------------------------------------------
# Review & iteration data (for the `review-report` tool).
LM_RETENTION_DAYS=30      # rolling retention (days) for event log + equity curve + logs
LM_EVENTS=1               # 1 = write state/events/*.jsonl (per-poll/discovery/decisions)
LM_EVENT_POLL_EVERY_S=10  # throttle the per-pool "poll" heartbeat event (decisions
                          # are always logged) so a fast cadence doesn't bloat the log
