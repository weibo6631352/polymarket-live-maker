# Copy to `.env` (which is gitignored) and fill in. NEVER commit `.env`.
#
# The signer's private key. Read from the environment ONLY — the code never
# writes, logs, or transmits it anywhere but the official SDK.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional. Funding/proxy wallet address. If omitted the SDK derives the
# deterministic deposit wallet from the signer key.
POLYMARKET_WALLET_ADDRESS=

# ---------------------------------------------------------------------------
# REAL-MONEY GO-LIVE — the operator's explicit switch (default OFF).
# With PM_LIVE unset or != "1" the bot runs in DRY-RUN: it computes and logs
# every order/cancel it WOULD send but submits NOTHING to the network.
# Set to 1 ONLY when you intend to place real orders with real funds.
PM_LIVE=0

# ---------------------------------------------------------------------------
# Capital & risk (safe starter values — ramp up only after multi-day survival).
LM_CAPITAL=200            # total USDC capital budget across the book
LM_MAX_POOLS=3            # start with a few pools, scale later
LM_MIN_DAILY=80           # ignore reward pools paying less than this $/day
LM_MAX_LOSS_PER_DAY=20    # kill-switch: halt+flatten if realized loss exceeds this
LM_MAX_INVENTORY_MULT=5   # per-pool inventory cap = this * min_size (shares)
