# pmm 温度日盘 maker 最小份额 live 试验 (基座默认 DRY — 武装靠箱上 drop-in, 不进 git)。
#
# 依据: 2026-07-03 全天数据 — 结算日 maker P&L vs settle = +3.77c/sh 均值 (+1.68c 量加权,
# 121 桶/9.8k prints); reward/AS 耦合在温度盘 (yolo 散户流) 上断裂。试验测: κ 真实奖励 + 捕获质量。
#
# 安装 (箱上):
#   mkdir -p /root/pmm-temp-trial && ln -sfn /root/polymarket-live-maker/.env /root/pmm-temp-trial/.env
#   cp cpp/deploy/pmm-temp-trial.service /etc/systemd/system/ && systemctl daemon-reload
# 武装 (用户决定; drop-in 只在箱上):
#   /etc/systemd/system/pmm-temp-trial.service.d/arm.conf:
#     [Service]
#     Environment=PM_TRADER_LIVE=1
#     Environment=LM_DRY_LIVE=0
#     Environment=LM_POOL_WHITELIST=<温度桶 condition ids, 每日由会话策展刷新>
#     Environment=LM_MIN_DAYS_TO_RESOLUTION=0 LM_CAPITAL=60 LM_MIN_DAILY=0 LM_MIN_POOL_REWARD=0
#     Environment=LM_MAX_LOSS_PER_DAY=10 LM_ORPHAN_SWEEP=0 LM_ORDER_EXPIRY_S=300
#   (LM_ORPHAN_SWEEP=0 必须 — 同账户跑着 tail-vendor, sweep 会平掉它的持仓;
#    LM_ORDER_EXPIRY_S=300 = GTD 死人开关, 箱死后挂单 5min 自动过期)
# 急停: systemctl stop pmm-temp-trial (SIGTERM → 撤全部挂单再退出)
[Unit]
Description=pmm temp-dailies maker trial (two-sided BUY-YES/BUY-NO on temperature buckets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/pmm-temp-trial
Environment=PM_TRADER_LIVE=0
Environment=LM_DRY_LIVE=1
Environment=LD_LIBRARY_PATH=/root/dds/lib:/root/dds/lib64
ExecStart=/root/polymarket-live-maker/cpp/build-tel/live-maker
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=90
MemoryHigh=384M
MemoryMax=512M
TasksMax=400
SyslogIdentifier=pmm-temp-trial
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
