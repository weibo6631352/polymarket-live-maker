// pmm/telemetry/telemetry.idl — 全量实时遥测 schema (Fast-DDS)
//
// 目标: 全量观测、便于分析。不只发摘要, 把每个"决策的完整上下文"都打出来 ——
//   定价为什么这么定 (QuoteDecision 含 σ/跳变/奖励/bleed/净/份额/尾部)、
//   池为什么选/拒 (PoolEval 含每个滤网结果 + 全部指标)、
//   每笔成交怎么被逆选的 (FillContext 含成交前后 mid + 盘口 + bleed)、
//   盘口微结构 (BookSnapshot)。
// bot 作为 Publisher 在每个决策点发布; 两个订阅者: ①记录器→SQLite(便于 SQL 分析) ②桥接→Web 仪表盘。

module pmm { module telemetry {

  // 心跳: ~1s, 总览盘。
  struct Heartbeat {
    long long ts_ms;
    string    run_state;            // running / killed / stopped
    double    uptime_s;
    double    usdc;
    double    equity;               // usdc + 持仓市值
    long      n_quotes;             // 活跃报价数
    long      n_pools_tracked;      // 在管池数
    double    book_resync_rps;      // 盘口刷新速率 (149hz 健康度)
  };

  // 报价决策: 每次定价的完整数学。分析"为什么这么定价/这么大 size"的核心。
  struct QuoteDecision {
    long long ts_ms;
    string    condition_id;
    string    question;
    string    token;
    string    side;                // BUY-YES / BUY-NO
    long long book_seq;            // 回链到决策当下的 OrderBookL2 (连贯通: 精确重建所见盘口)
    double    mid;
    double    max_spread_c;        // 奖励带宽
    double    half_spread_c;       // 最终半价差 (optimal_half_spread 输出)
    double    sigma_c;             // 实现波动 (¢)
    double    jump_sigma_c;        // 跳变感知 σ (异常跳变抬升后)
    double    jump_anomaly;        // 跳变异常倍数 (>1=异常)
    double    est_reward;          // 估日奖励 (κ 校准后)
    double    bleed_per_day;       // 估逆选 bleed
    double    net_per_day;         // net = reward - bleed (优化目标)
    double    existing_qmin;       // 竞争 (带内对手挂量, 1/κ 充气)
    double    own_qmin;            // 自己挂量
    double    share_w;             // 估份额 W(s)
    double    size;
    double    committed_capital;
    double    tail_var;            // 尾部-VaR (单次成交最坏损失)
    boolean   net_gate_pass;       // 净边际门是否通过
    boolean   tail_capped;         // size 是否被尾部预算截断
    string    status;              // active / skipped / cancelled
    string    skip_reason;         // "" = 正常挂
  };

  // 选池评估: 每个发现周期、每个候选 —— 全部指标 + 每个滤网的结果。分析"为什么选/拒"的核心。
  struct PoolEval {
    long long ts_ms;
    string    condition_id;
    string    question;
    double    competitiveness;
    double    days_to_resolution;
    double    mid;
    double    volume;
    double    reward_rate_per_day;   // 原始日奖励率 ($/天, 未 κ 校准) —— curator 算奖励份额的分子
    double    volume_24hr;           // PM 24h 成交额 ($) —— 流量信号
    string    jump_verdict;        // SAFE / jumpy
    boolean   empty_band;
    double    vol_mult;            // 实现波动 / 带宽 (>2.5 被丢)
    double    est_reward;
    double    net_per_day;
    boolean   safe_pass;           // 各滤网逐个结果
    boolean   comp_pass;
    boolean   mid_pass;
    boolean   net_pass;
    boolean   days_pass;
    boolean   reward_pass;
    boolean   selected;
    string    reject_reason;       // "" = 选中
  };

  // 成交上下文: 每笔 maker fill 的完整逆选画面 —— 成交前后 mid (逆选移动)、盘口、bleed。
  struct FillContext {
    long long ts_ms;
    string    condition_id;
    string    question;
    string    token;
    string    side;
    double    size;
    double    price;
    string    leg;                 // yes / no
    double    mid_before;          // 成交前 mid
    double    mid_after;           // 成交后 mid (差 = 逆选移动)
    double    bleed;               // 该笔逆选损失
    double    book_bid;            // 成交时盘口
    double    book_ask;
    long long book_seq;            // 回链 OrderBookL2 (连贯通)
    double    inventory_after;     // 成交后该腿持仓
    boolean   reconciled;          // 是否触发 reconcile 纠腿
  };

  // 价档: 订单簿一档 (价 + 量)。
  struct PriceLevel {
    double    price;
    double    size;
  };

  // 订单簿 L2 全档快照: 每次盘口更新都发 —— WS 每条 + REST 每次 resync, 全部档位(非仅顶档)。
  // "从根源最全": 在 bot 收到行情的源头捕获, 不摘要、不丢档。
  // seq 按 token 单调递增 → 连贯性 + 丢更检测; 任何 QuoteDecision/FillContext 都带 book_seq 回链到这里,
  // 可精确重建"bot 决策当下看到的盘口" —— 这就是"连贯通"。
  struct OrderBookL2 {
    long long ts_ms;
    string    condition_id;
    string    token;
    long long seq;                 // 单调序号 (连贯/丢更检测)
    string    source;              // ws / rest_resync
    string    update_type;         // snapshot / delta
    double    mid;
    double    inband_qmin;         // 派生: 带内最小挂量 (竞争度量)
    sequence<PriceLevel> bids;     // 全部买档 (价降序)
    sequence<PriceLevel> asks;     // 全部卖档 (价升序)
  };

  // 原始源消息: WS/REST 收到的 payload 原样捕获 (解析前, 最高保真)。
  // "原始全量" —— 连解析都不丢, 可事后重放/重析任何字段。结构化 OrderBookL2 之外的兜底全量层。
  struct RawFeed {
    long long ts_ms;
    string    channel;             // market / user / rest_book
    string    condition_id;
    string    token;
    long long seq;
    string    payload;             // 原始 JSON 原样
  };

  // 持仓快照: 每个非零持仓 (链上真实)。
  struct Position {
    long long ts_ms;
    string    condition_id;
    string    token;
    string    outcome;
    double    size;
    double    value;
  };

  // 净值/盈亏快照: 完整分项。
  struct EquitySnapshot {
    long long ts_ms;
    double    usdc;
    double    position_value;
    double    equity;
    long      equity_dd_count;     // 急停持续性连续计数
    double    day_pnl;             // 当日盈亏
    double    realized_bleed;      // 累计逆选
    double    reward_accrued;      // 累计奖励
  };

  // 急停事件。
  struct KillEvent {
    long long ts_ms;
    string    kind;                // signal / equity-drawdown / churn / manual
    string    reason;
  };

  // 奖励快照。
  struct RewardSnapshot {
    long long ts_ms;
    double    daily_reward;
    double    official_total;
  };

  // 通用日志事件: reflex 撤单 / reconcile 纠腿 / 孤立清扫 / 链上查询(含延迟) / 发现周期 等。
  // kind 区分; detail 是结构化字符串 (key=val), 兜住所有杂项, 不漏任何动作。
  struct LogEvent {
    long long ts_ms;
    string    kind;                // reflex_cancel / reconcile / orphan_sweep / chain_query / discovery / ...
    string    condition_id;        // "" = 全局
    double    latency_ms;          // 相关延迟 (如链上查询耗时); 无则 0
    string    detail;              // key=val; ... 自由结构化
  };

  // === 执行/订单生命周期: 原始订单状态机 (submit→ack→fill/cancel/reject/expire) + 交易所延迟。
  // 现在只发了 QuoteDecision(决策)和 Fill(成交), 缺中间的真实订单流转。
  struct OrderEvent {
    long long ts_ms;
    string    condition_id;
    string    token;
    string    order_id;
    string    phase;               // submit / ack / reject / cancel_req / cancel_ack / expire
    string    side;
    double    price;
    double    size;
    long      signature_type;
    double    latency_ms;          // 该阶段耗时 (submit→ack 等)
    string    error;               // 拒单/失败原因
  };

  // === 市场公开成交流 (Tape): 池里每笔公开成交, 不只我们的 —— 逆选根因。
  // 知情 taker 扫盘 → 我们报价被逆选成交。只有看到公开 tape 才知道"是不是被知情流吃了"。最高价值缺口。
  struct TradePrint {
    long long ts_ms;
    string    condition_id;
    string    token;
    double    price;
    double    size;
    string    taker_side;          // buy / sell (吃单方向 = 买卖压)
    boolean   is_ours;
  };

  // === 行情连接健康: WS 连断/重连/消息率/丢更/交易所延迟/订阅态 (之前"看不到 WS 日志"的疑问就靠它)。
  struct FeedHealth {
    long long ts_ms;
    string    channel;             // market / user
    string    state;               // connected / disconnected / reconnecting
    double    msg_rate;            // 消息/秒
    long      gap_count;           // 丢更数
    double    exch_lag_ms;         // 交易所 ts vs 本地接收
    long      n_subscribed;
  };

  // === 延迟剖面: 各动作耗时, 诊断"慢→逆选"。
  struct LatencyProfile {
    long long ts_ms;
    double    place_ms;            // 决策→挂单 ack
    double    cancel_ms;           // 撤单→ack
    double    chain_query_ms;      // 链上查询
    double    loop_tick_ms;        // 事件循环单 tick
    double    book_staleness_ms;   // 盘口最新更新距今 (新鲜度)
  };

  // === 链上/结算: 原始链上态 (逐 token 持仓 + USDC + allowance) + 结算延迟 (BUY-NO/假急停根因层)。
  struct ChainState {
    long long ts_ms;
    string    token;
    double    chain_size;
    double    usdc;
    double    allowance;
    double    settlement_lag_ms;   // 成交→链上反映时延
    long      pending_inflight;    // 在途未结算
  };

  // === 风险/安全态: 各刹车/预算实时态 (之前只有 KillEvent 在触发瞬间, 这个是连续态)。
  struct RiskState {
    long long ts_ms;
    boolean   kill_armed;
    long      equity_dd_count;     // 净值连续跌破计数
    long      churn_count;         // churn 窗口成交数
    boolean   chain_flat_guard;    // 持仓守卫是否阻挂
    double    capital_deployed;
    double    tail_budget_used;
    double    drawdown;
  };

  // === 发现/选池漏斗: 扫描分项 (各阶段丢了多少、为什么) —— 选池的"漏斗全貌"。
  struct DiscoveryScan {
    long long ts_ms;
    long      n_scanned;
    long      n_safe;
    long      n_dropped_jumpy;
    long      n_dropped_depleted;
    long      n_dropped_extreme;
    long      n_dropped_comp;
    long      n_selected;
    double    scan_duration_ms;
  };

  // === 配置/版本溯源: 哪套配置 + 哪个 commit 产出了这批数据 (启动 + 变更时发) —— 分析必须知道。
  struct ConfigSnapshot {
    long long ts_ms;
    string    git_commit;
    double    capital;
    double    max_loss;
    double    jump_vol_weight;
    double    max_competitiveness;
    double    max_pool_frac;
    double    tail_budget;
    string    extra_json;          // 其余全部参数 key=val
  };

  // === 系统/进程健康。
  struct SystemHealth {
    long long ts_ms;
    double    cpu_pct;
    double    mem_mb;
    double    http_req_rate;       // HTTP 请求/秒
    long      rate_limit_hits;
    double    db_write_ms;
    long      thread_count;
  };

  // === 每池奖励分项: 实测每市场赚的奖励 vs 估计, 验证 κ 校准 + 看哪些池真发钱。
  struct PoolReward {
    long long ts_ms;
    string    condition_id;
    string    question;
    double    est_reward;
    double    realized_reward;     // /rewards/user/markets 实测
    double    share;
  };

  // === 控制 (host→bot, 唯一反向 topic): 外部 curator (这个 session) 经 DDS 实时推选中池白名单,
  // bot 订阅热更 dyn_whitelist_, 不重启。这是"完全由 LLM 动态选池"的闭环回路。
  struct CuratorCommand {
    long long ts_ms;
    string    whitelist;           // 逗号分隔 condition_id (本轮选中池集; 空串 = 清空白名单)
    string    note;                // curator 理由摘要 (审计/可观测)
  };

}; };
